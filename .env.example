# Core LLM settings
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MANAGER_REGULAR_MODEL=deepseek-v4-flash
MANAGER_HARD_MODEL=deepseek-v4-pro

# Deployment settings
APP_PORT=10000
COMPOSE_PROJECT_NAME=iot-agent-new
ENABLE_DOCKER_RUNTIME=true
SUBAGENT_DOCKER_IMAGE=binary-audit-subagent:latest
SUBAGENT_DOCKER_NETWORK_MODE=auto
HOST_WORKSPACE_DIR=/srv/iot-agent-new

# Runtime tuning
MAX_PARALLEL_SUBAGENTS=4
LOOP_THRESHOLD=3
NOTE_RECALL_THRESHOLD=3
ROUND_RESET_THRESHOLD=100
AGENT_DISCUSSION_MAX_ROUNDS=6
AGENT_COORDINATION_TIMEOUT_SECONDS=0.35
LLM_TIMEOUT_SECONDS=120
TOOL_OUTPUT_LIMIT=12000
TOOL_TIMEOUT_SECONDS=30

# Optional tool integrations
IDA_HEADLESS_PATH=
HOST_IDA_INSTALL_DIR=
HOST_IDA_USER_DIR=
CONTAINER_IDA_PATH=/opt/ida/idat
CONTAINER_IDA_USER_DIR=/root/.idapro
ROOTFS_ELF_TOOL_DIR=
CONTAINER_ROOTFS_ELF_TOOL_DIR=/opt/rootfs_elf
PWN_SKILL_ZIP_PATH=
PWN_SKILL_DIRNAME=ctf-pwn
